{
  "name": "react-router-starterkit",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "prepare": "husky",
    "lint": "bunx biome check .",
    "lint:fix": "bunx biome check --write .",
    "lint:css": "bunx stylelint app/**/*.css",
    "lint:css:fix": "bunx stylelint app/**/*.css --fix",
    "format": "bunx biome format --write .",
    "check": "bun run typecheck && bun run lint && bun run lint:css",
    "ui:add": "bunx shadcn@latest add",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio",
    "storybook": "./scripts/storybook.sh dev",
    "storybook:build": "./scripts/storybook.sh build",
    "build-storybook": "./scripts/storybook.sh build"
  },
  "dependencies": {
    "@libsql/client": "^0.15.10",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-router/node": "^7.7.1",
    "@react-router/serve": "^7.7.1",
    "@tanstack/react-query": "^5.84.1",
    "@tanstack/react-store": "^0.7.3",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/store": "^0.7.2",
    "axios": "^1.11.0",
    "better-auth": "^1.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.4",
    "isbot": "^5.1.27",
    "lucide-react": "^0.536.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.7.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@react-router/dev": "^7.7.1",
    "@storybook/addon-a11y": "^9.1.0",
    "@storybook/addon-docs": "^9.1.0",
    "@storybook/addon-links": "^9.1.0",
    "@storybook/addon-onboarding": "^9.1.0",
    "@storybook/react-vite": "^9.1.0",
    "@tailwindcss/vite": "^4.1.4",
    "@tanstack/react-query-devtools": "^5.84.1",
    "@types/node": "^20",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "storybook": "^9.1.0",
    "stylelint": "^16.23.0",
    "stylelint-config-standard": "^39.0.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
